# ------------------------------------------------------------------ printer ----

_cache = {"t": 0, "v": {}}


def printer_info(cfg):
    """Live printer facts, cached briefly so a page refresh is not an IPP storm."""
    if time.time() - _cache["t"] < 20:
        return _cache["v"]
    info = {"state": None, "media_ready": None, "finishings": [], "media": [],
            "uri": None, "model": None}
    try:
        uri = subprocess.run(["lpstat", "-v", cfg["TARGET_QUEUE"]],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"ipp://([^/\s]+)", uri)
        if m:
            info["uri"] = m.group(1)
            r = subprocess.run(
                ["ipptool", "-tv", f"ipp://{m.group(1)}/ipp/print",
                 "get-printer-attributes.test"],
                capture_output=True, text=True, timeout=8).stdout
            def grab(name):
                mm = re.search(rf"{name} \([^)]*\) = (.+)", r)
                return mm.group(1).strip() if mm else None
            info["state"] = grab("printer-state")
            info["model"] = grab("printer-make-and-model")
            info["media_ready"] = grab("media-ready")
            fs = grab("finishings-supported") or ""
            name2enum = {"none": "3", "trim": "11",
                         "trim-after-pages": "60", "trim-after-job": "63"}
            info["finishings"] = [name2enum[x] for x in fs.split(",")
                                  if x.strip() in name2enum]
            ms = grab("media-supported") or ""
            info["media"] = [x.strip() for x in ms.split(",") if x.strip()][:40]
    except Exception:
        pass
    _cache.update(t=time.time(), v=info)
    return info


def queue_states():
    try:
        out = subprocess.run(["lpstat", "-p"], capture_output=True, text=True,
                             timeout=5).stdout
        return [l.strip() for l in out.splitlines() if l.startswith("printer")]
    except Exception:
        return []


