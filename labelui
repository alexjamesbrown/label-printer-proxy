def esc(x):
    return html.escape(str(x), quote=True)


def field_html(key, val, info, errors):
    group, label, hint = FIELDS.get(key, ("adv", key, HELP_ADV.get(key, "")))
    err = errors.get(key)
    cls = ' class="err"' if err else ""
    if key == "FINISHINGS":
        opts = info.get("finishings") or list(FINISHING_LABELS)
        body = f'<select name="{key}">' + "".join(
            f'<option value="{esc(o)}"{" selected" if str(val)==o else ""}>'
            f'{esc(FINISHING_LABELS.get(o, o))}</option>' for o in opts) + "</select>"
    elif key == "MEDIA" and info.get("media"):
        opts = info["media"]
        if val not in opts:
            opts = [val] + opts
        body = f'<select name="{key}">' + "".join(
            f'<option value="{esc(o)}"{" selected" if str(val)==o else ""}>'
            f'{esc(o)}</option>' for o in opts) + "</select>"
    else:
        body = f'<input name="{key}" value="{esc(val)}">'
    out = [f'<div{cls}><label for="{key}">{esc(label)}</label>', body]
    if err:
        out.append(f'<div class="errmsg">{esc(err)}</div>')
    if hint:
        out.append(f'<div class="hint">{esc(hint)}</div>')
    out.append("</div>")
    return "".join(out)


def page(cfg, info, flash=None, errors=None, recrop_result=None, recrop_job=None):
    errors = errors or {}
    q = queue_states()
    media_mismatch = (info.get("media_ready") and cfg.get("MEDIA")
                      and info["media_ready"] != cfg["MEDIA"])

    h = [f'<!doctype html><html lang="en"><head><meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width,initial-scale=1">',
         '<title>Label Printer settings</title>',
         f'<style>{CSS}</style></head><body><div class="wrap">',
         '<h1>Label Printer (auto-crop)</h1>',
         '<p class="sub">Settings apply to the next job. Nothing here prints.</p>']

    if flash:
        kind, msg = flash
        h.append(f'<div class="flash {kind}">{esc(msg)}</div>')
    if media_mismatch:
        h.append(
            f'<div class="flash warn">The printer currently has '
            f'<b>{esc(info["media_ready"])}</b> loaded, but this is set to '
            f'<b>{esc(cfg["MEDIA"])}</b>. Labels will come out the wrong size.</div>')

    # ---- status
    h.append('<div class="card"><h2>Status</h2><table>')
    h.append(f'<tr><td>Printer</td><td>{esc(info.get("model") or "unknown")}'
             f' &middot; {esc(info.get("uri") or "?")}</td></tr>')
    h.append(f'<tr><td>State</td><td>{esc(info.get("state") or "unreachable")}</td></tr>')
    h.append(f'<tr><td>Roll loaded</td><td>{esc(info.get("media_ready") or "?")}</td></tr>')
    for line in q:
        h.append(f'<tr><td>Queue</td><td>{esc(line)}</td></tr>')
    h.append("</table></div>")

    # ---- settings
    h.append('<form method="post" action="/save">')
    for gid, title in (("roll", "Roll and cutter"), ("behaviour", "Behaviour")):
        keys = [k for k in labelcrop.DEFAULTS
                if FIELDS.get(k, ("adv",))[0] == gid]
        h.append(f'<div class="card"><h2>{title}</h2><div class="grid">')
        h += [field_html(k, cfg.get(k, ""), info, errors) for k in keys]
        h.append("</div></div>")

    adv = [k for k in labelcrop.DEFAULTS if k not in FIELDS]
    h.append('<div class="card"><details><summary>Advanced &mdash; detection tuning'
             '</summary><p class="hint">Only worth touching if something is being '
             'cropped wrongly. Use <b>Re-crop</b> on a job below to check a change '
             'before printing.</p><div class="grid">')
    h += [field_html(k, cfg.get(k, ""), info, errors) for k in adv]
    h.append("</div></details></div>")
    h.append('<div class="bar"><button type="submit">Save settings</button>'
             '<span class="hint">No restart needed &mdash; the backend rereads '
             'the file on every job.</span></div></form>')

    # ---- recrop result
    if recrop_result:
        h.append(f'<div class="card"><h2>Re-crop of {esc(recrop_job)} '
                 'with current settings</h2><div class="pair">')
        for i, png in enumerate(recrop_result["pages"]):
            import base64
            b = base64.b64encode(png).decode()
            h.append(f'<div><img src="data:image/png;base64,{b}" alt="label {i+1}">'
                     f'<div class="cap">label {i+1}</div></div>')
        h.append("</div><p class=hint>")
        for p in recrop_result["previews"]:
            if not p.get("clip"):
                h.append(f'<span class="tag">page {p["page"]+1}: '
                         f'{esc(p["reason"])}, skipped</span>')
            else:
                h.append(f'<span class="tag">page {p["page"]+1}: {esc(p["reason"])}, '
                         f'rotate {p["rotate"]}, scale {p["scale"]:.2f}</span>')
        h.append("</p><p class=hint>Nothing was printed.</p></div>")

    # ---- jobs
    js = jobs(cfg)
    h.append('<div class="card"><h2>Recent jobs</h2>')
    if not js:
        h.append('<p class="hint">Nothing kept yet. Print something, or check '
                 'KEEP_JOBS is above zero.</p>')
    for stamp, has_in, has_out in js:
        h.append('<div class="job"><div class="pair">')
        if has_in:
            h.append(f'<div><img src="/thumb?job={urllib.parse.quote(stamp)}'
                     f'&which=in" alt="input" loading="lazy">'
                     '<div class="cap">in</div></div>')
        if has_out:
            h.append(f'<div><img src="/thumb?job={urllib.parse.quote(stamp)}'
                     f'&which=out" alt="output" loading="lazy">'
                     '<div class="cap">printed</div></div>')
        h.append(f'</div><div class="jmeta"><div class="stamp">{esc(stamp)}</div>'
                 f'<form method="post" action="/recrop" style="margin-top:8px">'
                 f'<input type="hidden" name="job" value="{esc(stamp)}">'
                 f'<button class="ghost" type="submit">Re-crop with current settings'
                 f'</button></form></div></div>')
    h.append("</div></div></body></html>")
    return "".join(h)


# -------------------------------------------------------------------- server ----


def parse_allow(spec):
    nets = []
    for part in spec.split(","):
        part = part.strip()
        if part:
            try:
                nets.append(ipaddress.ip_network(part, strict=False))
            except ValueError:
                print(f"labelui: ignoring bad CIDR {part!r}", file=sys.stderr)
    return nets


class Handler(BaseHTTPRequestHandler):
    server_version = "labelui"
    allow_nets = []

    def log_message(self, fmt, *a):
        sys.stderr.write("labelui: %s %s\n" % (self.client_address[0], fmt % a))

    def permitted(self):
        try:
            ip = ipaddress.ip_address(self.client_address[0])
        except ValueError:
            return False
        return any(ip in n for n in self.allow_nets)

    def guard(self):
        if self.permitted():
            return True
        self.log_message("DENIED (not in LABELUI_ALLOW)")
        self.send_error(403, "Not permitted from this address")
        return False

    def reply(self, body, ctype="text/html; charset=utf-8", code=200):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def form(self):
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n).decode("utf-8", "replace")
        return {k: v[0] for k, v in urllib.parse.parse_qs(raw).items()}

    def do_GET(self):
        if not self.guard():
            return
        u = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(u.query)
        cfg = labelcrop.load_config(CONF)

        if u.path == "/thumb":
            stamp = (qs.get("job") or [""])[0]
            which = (qs.get("which") or ["in"])[0]
            if which not in ("in", "out") or not re.match(r"^[\w.-]+$", stamp):
                return self.send_error(400, "bad request")
            path = os.path.join(cfg["KEEP_DIR"], f"{stamp}-{which}.pdf")
            if not os.path.exists(path):
                return self.send_error(404, "not kept")
            try:
                png = render_png(path)
            except Exception as e:
                return self.send_error(500, f"render failed: {e}")
            if png is None:
                return self.send_error(404, "no pages")
            return self.reply(png, "image/png")

        if u.path in ("/", "/index.html"):
            flash = None
            if qs.get("saved"):
                flash = ("ok", "Settings saved. They apply to the next job.")
            return self.reply(page(cfg, printer_info(cfg), flash=flash))
        self.send_error(404, "not found")

    def do_POST(self):
        if not self.guard():
            return
        u = urllib.parse.urlparse(self.path)
        cfg = labelcrop.load_config(CONF)
        info = printer_info(cfg)

        if u.path == "/recrop":
            stamp = self.form().get("job", "")
            if not re.match(r"^[\w.-]+$", stamp):
                return self.send_error(400, "bad job")
            res, err = recrop(stamp, cfg)
            flash = ("bad", f"Re-crop failed: {err}") if err else None
            return self.reply(page(cfg, info, flash=flash,
                                   recrop_result=res, recrop_job=stamp))

        if u.path == "/save":
            values, errors = validate(self.form(), info)
            if errors:
                merged = dict(cfg)
                merged.update(values)
                return self.reply(page(
                    merged, info,
                    flash=("bad", f"{len(errors)} setting(s) rejected. "
                                  "Nothing was saved."), errors=errors))
            try:
                write_config(values, CONF, cfg.get("KEEP_DIR"))
            except Exception as e:
                return self.reply(page(cfg, info, flash=(
                    "bad", f"Could not write {CONF}: {e}")))
            self.send_response(303)
            self.send_header("Location", "/?saved=1")
            self.end_headers()
            return
        self.send_error(404, "not found")


def main(argv):
    global PORT, ALLOW, CONF
    port, allow, conf = PORT, ALLOW, CONF
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--port":
            i += 1; port = int(argv[i])
        elif a == "--allow":
            i += 1; allow = argv[i]
        elif a == "--conf":
            i += 1; conf = argv[i]
        elif a == "--backend":
            i += 1  # already loaded at import; accepted for symmetry
        else:
            print(__doc__); return 2
        i += 1
    CONF = conf
    Handler.allow_nets = parse_allow(allow)
    if not Handler.allow_nets:
        print("labelui: refusing to start with an empty allowlist", file=sys.stderr)
        return 1
    srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    print(f"labelui: listening on :{port}, allowing "
          f"{', '.join(str(n) for n in Handler.allow_nets)}", file=sys.stderr)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
