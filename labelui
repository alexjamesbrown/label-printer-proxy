def write_config(values, path=CONF, backup_dir=None):
    """Update KEY=VALUE lines in place, preserving comments and order.

    The config file carries a lot of explanation. Rewriting it from a dict would
    throw all of that away, so each line is edited where it stands and unknown
    keys are appended at the end.

    Written in place rather than via a temp file and rename, because this runs as
    `lp` and /etc is 0755 root:root: we can write the file (0664 root:lp) but
    cannot create a sibling in that directory. For the same reason the backup
    goes to backup_dir, which lp owns. The payload is a few KB written in one
    call, and labelcrop falls back to DEFAULTS on anything it cannot parse, so
    losing atomicity here is not a real exposure.
    """
    try:
        with open(path) as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        lines = []

    seen, out = set(), []
    for line in lines:
        m = re.match(r"^(\s*)([A-Za-z_][A-Za-z0-9_]*)(\s*=\s*)(.*)$", line)
        if m and m.group(2) in values:
            k = m.group(2)
            seen.add(k)
            out.append(f"{m.group(1)}{k}={values[k]}\n")
        else:
            out.append(line)
    extra = [k for k in values if k not in seen]
    if extra:
        if out and not out[-1].endswith("\n"):
            out.append("\n")
        out.append("\n# Added by labelui\n")
        out += [f"{k}={values[k]}\n" for k in extra]
    data = "".join(out)

    if backup_dir and os.path.isdir(backup_dir) and lines:
        try:
            with open(os.path.join(backup_dir, "labelproxy.conf.bak"), "w") as fh:
                fh.writelines(lines)
        except OSError as e:
            # A failed backup must not block the save; say so and carry on.
            print(f"labelui: could not write backup: {e}", file=sys.stderr)

    with open(path, "w") as fh:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())


def validate(form, info):
    """Returns (clean_values, {key: error}). Nothing is written unless clean."""
    values, errors = {}, {}
    allowed_fin = info.get("finishings") or list(FINISHING_LABELS)
    for key in labelcrop.DEFAULTS:
        if key not in form:
            continue
        raw = form[key].strip()
        if key == "FINISHINGS":
            if raw not in allowed_fin:
                errors[key] = f"printer does not support finishings={raw}"
            else:
                values[key] = raw
            continue
        if key in TEXT:
            if not raw:
                errors[key] = "cannot be empty"
            elif len(raw) > 200 or "\n" in raw:
                errors[key] = "too long"
            else:
                values[key] = raw
            continue
        try:
            v = float(raw)
        except ValueError:
            errors[key] = "must be a number"
            continue
        lo, hi = RANGES.get(key, (-1e9, 1e9))
        if not (lo <= v <= hi):
            errors[key] = f"must be between {lo} and {hi}"
            continue
        if key in INTS:
            if v != int(v):
                errors[key] = "must be a whole number"
                continue
            values[key] = str(int(v))
        else:
            values[key] = ("%g" % v)
    return values, errors


# ------------------------------------------------------------------ previews ----


def jobs(cfg):
    """Kept in/out pairs, newest first, as [(stamp, has_in, has_out)]."""
    d = cfg.get("KEEP_DIR") or ""
    if not d or not os.path.isdir(d):
        return []
    stamps = {}
    for fn in os.listdir(d):
        m = re.match(r"^(\d{8}-\d{6}-\S+?)-(in|out)\.pdf$", fn)
        if m:
            stamps.setdefault(m.group(1), set()).add(m.group(2))
    return [(s, "in" in k, "out" in k)
            for s, k in sorted(stamps.items(), reverse=True)]


def render_png(pdf_path, boxes=None, max_px=360, page=0):
    """One page of a PDF as PNG bytes, optionally with a red detection box."""
    doc = labelcrop.open_input(pdf_path, labelcrop.DEFAULTS)
    try:
        if page >= doc.page_count:
            return None
        src = doc[page]
        shot = fitz.open()
        q = shot.new_page(width=src.rect.width, height=src.rect.height)
        try:
            q.show_pdf_page(q.rect, doc, page)
        except ValueError:
            pass  # genuinely empty page; leave it white
        if boxes:
            for b in boxes:
                q.draw_rect(fitz.Rect(*b), color=(0.85, 0, 0),
                            width=max(1.5, src.rect.height / 250))
        s = max_px / max(src.rect.width, src.rect.height)
        png = shot[0].get_pixmap(matrix=fitz.Matrix(s, s), alpha=False).tobytes("png")
        shot.close()
        return png
    finally:
        doc.close()


def recrop(stamp, cfg):
    """Re-run detection on a kept job with current settings. Prints nothing."""
    src = os.path.join(cfg["KEEP_DIR"], f"{stamp}-in.pdf")
    if not os.path.exists(src):
        return None, "input PDF no longer kept"
    work = tempfile.mkdtemp(prefix="labelui-")
    try:
        out = os.path.join(work, "out.pdf")
        previews = []
        n = labelcrop.build(src, out, cfg, previews=previews)
        boxes = [p["clip"] for p in previews if p.get("clip")]
        pages = []
        doc = fitz.open(out)
        try:
            for i in range(doc.page_count):
                s = 360 / max(doc[i].rect.width, doc[i].rect.height)
                pages.append(doc[i].get_pixmap(
                    matrix=fitz.Matrix(s, s), alpha=False).tobytes("png"))
        finally:
            doc.close()
        return {"n": n, "previews": previews, "boxes": boxes, "pages": pages}, None
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"
    finally:
        shutil.rmtree(work, ignore_errors=True)


