MM = 72.0 / 25.4  # mm -> PostScript points


def load_config(path=CONFIG_PATH):
    """DEFAULTS overlaid with KEY=VALUE lines from path, then LABELPROXY_* env."""
    cfg = dict(DEFAULTS)
    try:
        with open(path) as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip().upper()
                if k in cfg:
                    cfg[k] = v.strip().strip('"').strip("'")
                else:
                    log("WARNING", f"unknown config key {k!r} in {path}, ignored")
    except FileNotFoundError:
        pass
    except OSError as e:
        log("WARNING", f"cannot read {path} ({e}), using defaults")
    for k in cfg:
        env = os.environ.get("LABELPROXY_" + k)
        if env is not None:
            cfg[k] = env
    return cfg


def num(cfg, key):
    try:
        return float(cfg[key])
    except (TypeError, ValueError):
        log("WARNING", f"{key}={cfg[key]!r} is not a number, using {DEFAULTS[key]}")
        return float(DEFAULTS[key])


def log(level, msg):
    """CUPS reads the level prefix off stderr: DEBUG/INFO/WARNING/ERROR."""
    print(f"{level}: {NAME}: {msg}", file=sys.stderr, flush=True)


# ------------------------------------------------------------- detection ----


def _fitz():
    try:
        import pymupdf
        return pymupdf
    except ImportError:
        import fitz
        return fitz


def _longest_run(line, table):
    """Longest continuous run of ink in one row or column of pixels.

    Binarises through a 256-byte translate table, then splits on the background
    byte, so the scan happens in C rather than a Python loop. Returns
    (length, first_index, last_index), or (0, 0, -1) if there is no ink.
    """
    best = pos = 0
    best_end = -1
    for seg in line.translate(table).split(b"\x00"):
        n = len(seg)
        if n > best:
            best, best_end = n, pos + n - 1
        pos += n + 1
    return best, best_end - best + 1, best_end


def find_border_box(pix, cfg):
    """Outer extent of long continuous dark lines: a drawn label border.

    Two guards keep this from firing on things that are not labels. Runs longer
    than LINE_MAX_FRAC of the page are page frames and cut guides, so they are
    ignored. And the resulting rectangle is only accepted if some single line
    actually spans it in each axis, which is what distinguishes a real box from
    four unrelated rules that happen to bound a region.

    Returns a pixel box or None.
    """
    w, h, stride, buf = pix.width, pix.height, pix.stride, pix.samples
    dark = int(num(cfg, "DARK"))
    table = bytes(1 if i < dark else 0 for i in range(256))
    lo, hi = num(cfg, "LINE_MIN_FRAC"), num(cfg, "LINE_MAX_FRAC")
    min_count = int(num(cfg, "LINE_MIN_COUNT"))

    hlines, vlines = [], []
    for y in range(h):
        n, a, b = _longest_run(buf[y * stride:y * stride + w], table)
        if lo * w <= n <= hi * w:
            hlines.append((y, a, b))
    for x in range(w):
        n, a, b = _longest_run(buf[x::stride], table)
        if lo * h <= n <= hi * h:
            vlines.append((x, a, b))

    if len(hlines) < min_count or len(vlines) < min_count:
        return None

    top = min(l[0] for l in hlines)
    bot = max(l[0] for l in hlines)
    left = min(l[0] for l in vlines)
    right = max(l[0] for l in vlines)
    if right <= left or bot <= top:
        return None
    if (right - left) * (bot - top) < 0.02 * w * h:
        return None

    # Corroboration: a genuine rectangle has at least one horizontal line that
    # runs the full width of it, and one vertical line that runs its full
    # height. A header rule sitting above a label fails this, and we fall back
    # to the content box instead of cropping from the rule downwards.
    tol = num(cfg, "LINE_TOL_FRAC") * max(w, h)
    if not any(a <= left + tol and b >= right - tol for _, a, b in hlines):
        log("DEBUG", "border lines do not span the box horizontally")
        return None
    if not any(a <= top + tol and b >= bot - tol for _, a, b in vlines):
        log("DEBUG", "border lines do not span the box vertically")
        return None
    return (left, top, right + 1, bot + 1)


def _ink_grid(page, cfg, fitz):
    """Coarse boolean ink grid for the page.

    Rendered straight at grid resolution so the rasteriser does the averaging:
    a cell's grey level *is* its ink coverage. That keeps this independent of
    both page size and input resolution, and costs one small pixmap.
    """
    cells = max(16, int(num(cfg, "GRID_CELLS")))
    r = page.rect
    scale = cells / max(r.width, r.height)
    pix = page.get_pixmap(matrix=fitz.Matrix(scale, scale),
                          colorspace=fitz.csGRAY, alpha=False)
    gw, gh, stride, buf = pix.width, pix.height, pix.stride, pix.samples
    ink = int(num(cfg, "GRID_INK"))
    dark = int(num(cfg, "DARK"))
    t_ink = bytes(1 if i < ink else 0 for i in range(256))
    # A cell is "solid" when its averaged grey is dark, i.e. it is mostly
    # covered: a barcode bar or a filled block, not a text stroke.
    t_solid = bytes(1 if i < dark else 0 for i in range(256))
    grid = bytearray(gw * gh)
    solid = bytearray(gw * gh)
    for gy in range(gh):
        row = buf[gy * stride:gy * stride + gw]
        grid[gy * gw:(gy + 1) * gw] = row.translate(t_ink)
        solid[gy * gw:(gy + 1) * gw] = row.translate(t_solid)
    return grid, solid, gw, gh


def _components(grid, gw, gh):
    """8-connected components of the ink grid, as (x0, y0, x1, y1, cells)."""
    seen = bytearray(gw * gh)
    out = []
    for start in range(gw * gh):
        if not grid[start] or seen[start]:
            continue
        seen[start] = 1
        stack = [start]
        x0 = x1 = start % gw
        y0 = y1 = start // gw
        cells = 0
        while stack:
            i = stack.pop()
            cells += 1
            cx, cy = i % gw, i // gw
            if cx < x0:
                x0 = cx
            if cx > x1:
                x1 = cx
            if cy < y0:
                y0 = cy
            if cy > y1:
                y1 = cy
            for dy in (-1, 0, 1):
                ny = cy + dy
                if ny < 0 or ny >= gh:
                    continue
                for dx in (-1, 0, 1):
                    nx = cx + dx
                    if nx < 0 or nx >= gw:
                        continue
                    j = ny * gw + nx
                    if grid[j] and not seen[j]:
                        seen[j] = 1
                        stack.append(j)
        out.append((x0, y0, x1 + 1, y1 + 1, cells))
    return out


def _row_profile(grid, gw, gh):
    """Per-row (ink count, first inked column, last inked column)."""
    out = []
    for gy in range(gh):
        row = grid[gy * gw:(gy + 1) * gw]
        n = sum(row)
        if n:
            first = next(i for i, v in enumerate(row) if v)
            last = gw - 1 - next(i for i, v in enumerate(reversed(row)) if v)
        else:
            first = last = -1
        out.append((n, first, last))
    return out


def _cut_rows(rows, gw, gh, cfg):
    """Rows that look like a "cut here" rule.

    A rule is a *local spike* in how far ink reaches across the row: it runs
    nearly the full page width while the rows either side of it do not. Two
    earlier definitions were both wrong on real labels:

      - "longest continuous dark run" misses them entirely, because these lines
        are nearly always dashed and that only ever sees one dash;
      - "wide span inside a thin band" matched a bold centred heading (81% of
        the width) and missed the real line, which sat in a 9-row band with the
        text around it and so never looked thin.

    Measuring the span and requiring the neighbours to be much narrower catches
    the line and rejects the heading.
    """
    span_min = num(cfg, "CUTLINE_SPAN_FRAC") * gw
    drop = num(cfg, "CUTLINE_NEIGHBOUR_FRAC")
    thick_max = int(num(cfg, "CUTLINE_MAX_ROWS"))

    def span(gy):
        if gy < 0 or gy >= gh or not rows[gy][0]:
            return 0
        return rows[gy][2] - rows[gy][1] + 1

    # Group consecutive wide rows into runs. A rule can straddle two grid rows
    # when it falls on a cell boundary, and testing single rows then makes each
    # half look like a wide neighbour of the other and finds nothing.
    cuts, gy = [], 0
    while gy < gh:
        if span(gy) < span_min:
            gy += 1
            continue
        start = gy
        while gy < gh and span(gy) >= span_min:
            gy += 1
        run = list(range(start, gy))
        if len(run) > thick_max:
            continue          # a wide *block*, not a rule
        widest = max(span(i) for i in run)
        if span(start - 1) <= drop * widest and span(gy) <= drop * widest:
            cuts.append(run[len(run) // 2])
    return cuts


def _solid_frac(solid, gw, y0, y1):
    if y1 <= y0:
        return 0.0
    return sum(solid[y0 * gw:y1 * gw]) / float((y1 - y0) * gw)


def _striped(solid, pix, gw, gh, cfg):
    """Solid cells that are barcode-like: many ink edges across each pixel row.

    Solid ink finds a barcode, but it also finds a filled banner, and a sheet
    with a grey "Return Your Parcel" header then scores as solid as its label.
    Counting ink/paper transitions inside each solid cell on the line-detection
    pixmap tells the two apart: bars switch constantly, a fill never does. Only
    solid cells are examined, so the cost is a few hundred small slices.
    """
    dark = int(num(cfg, "DARK"))
    cw, ch = pix.width / float(gw), pix.height / float(gh)
    need = num(cfg, "STRIPE_EDGES") * ch
    t_bin = bytes(1 if i < dark else 0 for i in range(256))
    out = bytearray(gw * gh)
    for i, s in enumerate(solid):
        if not s:
            continue
        gx, gy = i % gw, i // gw
        x0, x1 = int(gx * cw), int((gx + 1) * cw)
        y0, y1 = int(gy * ch), int((gy + 1) * ch)
        edges = 0
        for y in range(y0, y1):
            row = pix.samples[y * pix.stride + x0:y * pix.stride + x1].translate(t_bin)
            edges += sum(1 for a, b in zip(row, row[1:]) if a != b)
        out[i] = 1 if edges >= need else 0
    return out


def _sides(solid, gw, gh, cut):
    """(ratio, keep_below, y0, y1) for splitting at cut: the denser side kept."""
    above, below = _solid_frac(solid, gw, 0, cut), _solid_frac(solid, gw, cut + 1, gh)
    hi, lo = max(above, below), min(above, below)
    keep_below = below >= above
    y0, y1 = (cut + 1, gh) if keep_below else (0, cut)
    return hi / (lo or 1e-9), keep_below, y0, y1


def _label_side(rows, solid, gw, gh, cut, cfg):
    """The label side of a cut as a grid box, or None if the cut is not one.

    The kept side must clear BLOCK_SOLID_MIN and beat the other side by
    BLOCK_SOLID_RATIO. Within it, short bands of pure text are trimmed, which
    removes a "YOU MUST ATTACH THIS LABEL" banner without ever touching a
    multi-line address block.
    """
    ratio, keep_below, y0, y1 = _sides(solid, gw, gh, cut)
    kept = _solid_frac(solid, gw, y0, y1)
    log("DEBUG", f"cut line at row {cut} ({cut / gh:.0%}); keeping "
                 f"{'below' if keep_below else 'above'}, solid {kept:.1%} "
                 f"(x{ratio:.1f})")
    if kept < num(cfg, "BLOCK_SOLID_MIN"):
        log("DEBUG", "neither side is solid enough to be a label, leaving the page")
        return None
    if ratio < num(cfg, "BLOCK_SOLID_RATIO"):
        log("DEBUG", "the cut line does not separate a label, leaving the page")
        return None

    # Trim short pure-text bands (banners) off the kept region.
    gap_min = max(1, int(round(num(cfg, "BLOCK_GAP_FRAC") * gh)))
    bands, cur, run = [], [], 0
    for gy in range(y0, y1):
        if rows[gy][0] == 0:
            run += 1
            if run >= gap_min and cur:
                bands.append(cur)
                cur = []
            continue
        run = 0
        cur.append(gy)
    if cur:
        bands.append(cur)
    if not bands:
        return None

    region_h = max(1, y1 - y0)
    trim_max = num(cfg, "BLOCK_TRIM_MAX_FRAC") * region_h
    keep = [b for b in bands
            if not (len(b) <= trim_max
                    and _solid_frac(solid, gw, b[0], b[-1] + 1)
                    < num(cfg, "BLOCK_SOLID_MIN"))]
    if not keep:
        keep = bands
    dropped = len(bands) - len(keep)
    if dropped:
        log("DEBUG", f"trimmed {dropped} short text band(s) off the label")

    ys = [gy for b in keep for gy in b]
    xs = [v for gy in ys for v in (rows[gy][1], rows[gy][2]) if v >= 0]
    if not xs:
        return None
    return (min(xs), ys[0], max(xs) + 1, ys[-1] + 1)


def find_label_block(grid, solid, gw, gh, cfg):
    """Pick the label out of a bare page that also carries instructions.

    Some carriers print a page of instructions, a "cut here" line, then the real
    label below it. The ink bounding box spans both, so the label ends up a
    postage stamp in the middle of the roll.

    This splits **only at an explicit cut rule**, never on whitespace alone, and
    keeps the side with more solid ink: the fraction of the region dark enough
    to be a barcode or a filled block rather than a text stroke. Plain ink
    coverage cannot tell those apart - measured on a real InPost label it was
    46% for the instructions against 50% for the label, while solid ink was 2.4%
    against 18.5%.

    With several cut lines, the one that best separates solid ink from the
    rest is used.

    Returns a grid-space (x0, y0, x1, y1) box, or None to leave the page alone.
    """
    rows = _row_profile(grid, gw, gh)
    cuts = _cut_rows(rows, gw, gh, cfg)
    if not cuts:
        return None
    cut = max(cuts, key=lambda c: _sides(solid, gw, gh, c)[0])
    return _label_side(rows, solid, gw, gh, cut, cfg)


def find_content_box(page, cfg, fitz):
    """Ink bounding box in page coordinates, with specks and edge strips gone.

    Returns (rect_or_None, inked_cell_fraction). The fraction is what the
    blank-page test uses, so the caller gets both from one pass.
    """
    grid, solid, gw, gh = _ink_grid(page, cfg, fitz)
    inked = sum(grid)
    frac = inked / float(gw * gh)
    if not inked:
        return None, frac, (grid, solid, gw, gh, [])

    comps = _components(grid, gw, gh)
    min_cells = max(1, int(round(num(cfg, "SPECK_AREA_FRAC") * gw * gh)))
    edge_cells = num(cfg, "EDGE_STRIP_FRAC") * gh
    band_cells = num(cfg, "EDGE_BAND_FRAC") * gh

    keep, dropped = [], []
    for c in comps:
        x0, y0, x1, y1, cells = c
        if cells < min_cells:
            dropped.append(("speck", c))
            continue
        if ((y1 <= edge_cells or y0 >= gh - edge_cells)
                and (y1 - y0) <= band_cells):
            dropped.append(("edge-strip", c))
            continue
        keep.append(c)

    if dropped:
        log("DEBUG", "discarded " + ", ".join(
            f"{why} {x1 - x0}x{y1 - y0}" for why, (x0, y0, x1, y1, _) in dropped))

    if not keep:
        # Everything looked like noise. Trust the raw ink rather than lose the page.
        keep = comps

    r = page.rect
    cw, ch = r.width / gw, r.height / gh
    box = fitz.Rect(
        r.x0 + min(c[0] for c in keep) * cw,
        r.y0 + min(c[1] for c in keep) * ch,
        r.x0 + max(c[2] for c in keep) * cw,
        r.y0 + max(c[3] for c in keep) * ch,
    ) & r
    return box, frac, (grid, solid, gw, gh, keep)


def _text_direction(page, fitz):
    """The way most of the page's text runs, as a unit vector on the page as
    shown: (1, 0) left to right, (0, -1) bottom to top, and so on.

    iOS and macOS re-paginate a landscape sheet onto portrait A4 by turning
    it a quarter turn, so a label that was *beside* its instructions arrives
    *below* them, sideways, and the gutter between them is horizontal. The
    direction the text runs says which way the content faces: the gutter
    search runs in the content's frame rather than the page's, and the final
    rotation is chosen so the label reads the right way up. Lines are weighted
    by length so a sideways "SENDER'S ADDRESS" sliver cannot outvote the
    sheet. Image-only input has no text and counts as upright.
    """
    m = page.rotation_matrix  # dir is reported in the unrotated frame
    votes = {}
    for block in page.get_text("dict").get("blocks", []):
        for line in block.get("lines", []):
            dx, dy = line["dir"]
            vx, vy = dx * m.a + dy * m.c, dx * m.b + dy * m.d
            key = (0, 1 if vy > 0 else -1) if abs(vy) > abs(vx) \
                else (1 if vx > 0 else -1, 0)
            votes[key] = votes.get(key, 0) + sum(len(s["text"]) for s in line["spans"])
    return max(votes, key=votes.get) if votes else (1, 0)


def _transpose(grid, gw, gh):
    """The gw x gh grid as a gh x gw grid: rows become columns."""
    out = bytearray(gw * gh)
    for gy in range(gh):
        out[gy::gh] = grid[gy * gw:(gy + 1) * gw]
    return out


def find_label_column(comps, solid, gw, gh, cfg, sideways=False):
    """Pick the label out of a page that carries its instructions beside it.

    Royal Mail return sheets print on landscape A4: the label on the left with
    nothing drawn round it, and a column of packing instructions on the right.
    There is no cut line, so find_label_block never fires, and the ink bbox
    spans both, which prints the instructions and shrinks the label to about
    half the roll.

    Splitting on whitespace is exactly what find_label_block refuses to do,
    and for good reason (see there). A column gutter is a much stronger signal
    than a horizontal gap, and it is still held to stricter rules than the
    cut-line split:

      - the gutter must be at least COLUMN_GAP_FRAC of the page wide and run
        the full height of the content: no component may reach across it. A
        label nearly always has something spanning its own width (a header, a
        rule, a barcode), so a gutter never falls inside one. The address-
        over-barcode gap that broke whitespace splitting is horizontal, and
        this never looks at horizontal gaps;
      - the kept column must cover BLOCK_MIN_AREA_FRAC of the page and clear
        BLOCK_SOLID_MIN, as a cut-line side must;
      - every other column must be text only: below PAGE_SOLID_MIN solid ink,
        the same test that makes a page an instruction page. A column with a
        barcode, QR code or filled block in it keeps the page whole.

    The known gap: a borderless label laid out as a text column beside a
    barcode column, with nothing at all spanning both, would lose its text.
    No real label seen so far is drawn that way.

    "Column" is a column of the *content*. When the sheet arrives turned a
    quarter turn (sideways=True: how an iPhone re-paginates landscape onto
    portrait A4) the whole analysis is transposed, so the gutter is horizontal
    on the page but still runs across the text, and a label's own stacked
    blocks are still never split.

    comps are the kept components from find_content_box, so specks and edge
    strips can neither bridge a gutter nor fake a column. Returns a grid-space
    (x0, y0, x1, y1) box, or None to leave the page alone.
    """
    if sideways:
        comps = [(y0, x0, y1, x1, n) for x0, y0, x1, y1, n in comps]
        solid, gw, gh = _transpose(solid, gw, gh), gh, gw
    gap_min = max(1, int(round(num(cfg, "COLUMN_GAP_FRAC") * gw)))
    groups = []  # [x0, x1, [components]]
    for c in sorted(comps):
        if groups and c[0] - groups[-1][1] < gap_min:
            groups[-1][1] = max(groups[-1][1], c[2])
            groups[-1][2].append(c)
        else:
            groups.append([c[0], c[2], [c]])
    if len(groups) < 2:
        return None

    def box(g):
        cs = g[2]
        return (min(c[0] for c in cs), min(c[1] for c in cs),
                max(c[2] for c in cs), max(c[3] for c in cs))

    def solid_in(b):
        x0, y0, x1, y1 = b
        n = sum(sum(solid[gy * gw + x0:gy * gw + x1]) for gy in range(y0, y1))
        return n / float((x1 - x0) * (y1 - y0))

    scored = sorted(((solid_in(box(g)), box(g)) for g in groups), reverse=True)
    best_solid, best = scored[0]
    area = (best[2] - best[0]) * (best[3] - best[1]) / float(gw * gh)
    log("DEBUG", f"{len(groups)} {'rows of sideways content' if sideways else 'columns'}; "
                 f"densest is {best_solid:.1%} solid ({area:.0%} of page), "
                 f"next {scored[1][0]:.1%}")
    if area < num(cfg, "BLOCK_MIN_AREA_FRAC"):
        log("DEBUG", "the densest column is too small to be a label, leaving the page")
        return None
    if best_solid < num(cfg, "BLOCK_SOLID_MIN"):
        log("DEBUG", "no column is solid enough to be a label, leaving the page")
        return None
    if any(s >= num(cfg, "PAGE_SOLID_MIN") for s, _ in scored[1:]):
        log("DEBUG", "another column has solid ink too, so it is not just "
                     "instructions, leaving the page")
        return None
    if sideways:
        best = (best[1], best[0], best[3], best[2])
    return best


def _grid_rect(box, r, gw, gh, fitz):
    """Grid-space (x0, y0, x1, y1) box back to page coordinates."""
    cw, ch = r.width / gw, r.height / gh
    return fitz.Rect(r.x0 + box[0] * cw, r.y0 + box[1] * ch,
                     r.x0 + box[2] * cw, r.y0 + box[3] * ch) & r


def find_label_in_border(border, grid, solid, pix, gw, gh, r, cfg, fitz):
    """Look for a cut line *inside* a drawn border and keep the label side.

    Some carriers (DPD returns) draw one box round the whole sheet: the
    instructions, a list of drop-off shops, a dashed cut line, and the label
    below it. The border detector is right that the box is the content, but
    printing all of it shrinks the label to 60%.

    The cut-line test cannot simply be run on the page: inside a border every
    row spans the border's width, because the border's own sides are ink at
    both ends, so no row is a spike. It is run instead on the border's
    interior, with the stroke cells peeled off, so spans are measured against
    the interior width.

    Inside a border the stakes are different: most bordered pages are plain
    labels, and a label has rules of its own. So this is stricter than the
    bare-page split in three ways, each learnt from real or synthetic input:

      - cuts are found at *pixel* level (CUTLINE_MAX_THICK_FRAC): a thin run
        of dark rows reaching across the interior. On the grid, two rows of
        two-column text spanned the DPD sheet like a rule and were taken for
        one, while the real cut (grey band, dashes, the label's top rule)
        filled four or five cells depending on the page size and was missed;
      - sides are scored on *striped* ink, not solid ink, because the sheet's
        grey header banner is as solid as a barcode and made the instructions
        side look like the label;
      - the side cut away must hold most of the ink inside the border
        (BORDER_CUT_MIN_INK). A label's own header rule is also a wide line
        with text above and barcodes below, and splitting there would lose
        the carrier name or the addressee.

    With several cuts passing, the one that cuts away the *least* is used:
    if a sheet also has a rule inside its label, that is the one that keeps
    the whole label.

    If no cut passes, None: the whole border prints exactly as before.
    """
    cw, ch = r.width / gw, r.height / gh
    gx0 = int((border.x0 - r.x0) / cw) + 1
    gy0 = int((border.y0 - r.y0) / ch) + 1
    gx1 = int((border.x1 - r.x0) / cw + 0.999) - 1
    gy1 = int((border.y1 - r.y0) / ch + 0.999) - 1

    # A stroke that lands on a cell boundary inks two cells. Peel edge rows and
    # columns that are nearly all ink until something that is not a line shows.
    def row_full(gy):
        return sum(grid[gy * gw + gx0:gy * gw + gx1]) >= 0.9 * (gx1 - gx0)

    def col_full(gx):
        return sum(grid[gy * gw + gx] for gy in range(gy0, gy1)) >= 0.9 * (gy1 - gy0)

    for _ in range(2):
        if gy1 - gy0 > 4 and row_full(gy0):
            gy0 += 1
        if gy1 - gy0 > 4 and row_full(gy1 - 1):
            gy1 -= 1
        if gx1 - gx0 > 4 and col_full(gx0):
            gx0 += 1
        if gx1 - gx0 > 4 and col_full(gx1 - 1):
            gx1 -= 1
    sw, sh = gx1 - gx0, gy1 - gy0
    if sw < 4 or sh < 4:
        return None

    sub_grid = bytearray(sw * sh)
    for y in range(sh):
        src = (gy0 + y) * gw + gx0
        sub_grid[y * sw:(y + 1) * sw] = grid[src:src + sw]
    rows = _row_profile(sub_grid, sw, sh)

    # Cut candidates from the pixels: runs of dark rows that reach across the
    # interior and are no taller than a rule. The interior is inset a little
    # further so a border stroke straddling a grid cell cannot make every row
    # look wide.
    pcw, pch = pix.width / float(gw), pix.height / float(gh)
    inset = int(0.02 * (gx1 - gx0) * pcw)
    px0, px1 = int(gx0 * pcw) + inset, int(gx1 * pcw) - inset
    py0, py1 = int(gy0 * pch), int(gy1 * pch)
    dark = int(num(cfg, "DARK"))
    t_bin = bytes(1 if i < dark else 0 for i in range(256))
    thick_max = num(cfg, "CUTLINE_MAX_THICK_FRAC") * max(pix.width, pix.height)
    span_min = num(cfg, "CUTLINE_SPAN_FRAC") * (px1 - px0)

    def wide(py):
        row = pix.samples[py * pix.stride + px0:py * pix.stride + px1].translate(t_bin)
        if 1 not in row:
            return False
        return len(row) - row[::-1].index(1) - row.index(1) >= span_min

    cuts, py = [], py0
    while py < py1:
        if not wide(py):
            py += 1
            continue
        start = py
        while py < py1 and wide(py):
            py += 1
        if py - start <= thick_max:
            c = int((start + py) / 2 / pch) - gy0
            if 0 < c < sh - 1 and c not in cuts:
                cuts.append(c)
    if not cuts:
        return None

    striped = _striped(solid, pix, gw, gh, cfg)
    sub_striped = bytearray(sw * sh)
    for y in range(sh):
        src = (gy0 + y) * gw + gx0
        sub_striped[y * sw:(y + 1) * sw] = striped[src:src + sw]

    ink_total = float(sum(rows[gy][0] for gy in range(sh)) or 1)
    min_ink = num(cfg, "BORDER_CUT_MIN_INK")
    passing = []
    for c in cuts:
        _, _, y0, y1 = _sides(sub_striped, sw, sh, c)
        cut_away = sum(rows[gy][0] for gy in range(sh) if not y0 <= gy < y1) / ink_total
        if cut_away < min_ink:
            log("DEBUG", f"cut at row {c} would cut away only {cut_away:.0%} of "
                         "the ink: a rule inside the label, not a cut line")
            continue
        passing.append((cut_away, c))
    if not passing:
        return None
    _, cut = min(passing)

    block = _label_side(rows, sub_striped, sw, sh, cut, cfg)
    if block is None:
        return None
    # Give back the full interior width: the label's own left and right edges
    # are the border, and a cut line splits a sheet top from bottom, not side
    # from side.
    return _grid_rect((gx0, gy0 + block[1], gx1, gy0 + block[3]), r, gw, gh, fitz)


def detect_page(page, cfg, info=None):
    """Work out what to print from one page.

    Order, most specific signal first:

      1. a drawn border box, which is how most carrier labels are delimited;
         then, inside it, a cut line that splits a sheet into instructions and
         label, in which case the label side is kept
      2. failing a border, the densest side of a cut line on the bare page,
         which is how a label sitting under a page of instructions is found
      3. failing a cut line, the densest of several columns separated by a
         full-height gutter, when every other column is text only, which is
         how a label sitting beside its instructions is found
      4. failing that, the ink bounding box
      5. and if that covers most of the page, the page *is* the content, so no
         crop at all

    A drawn border always wins over a density guess: it is an explicit statement
    about where the label is, whereas block splitting is inference. The cut
    line inside a border is only consulted *after* the border has fixed the
    width and the outer extent, and only ever trims top or bottom off it.

    Returns (clip_rect_or_None, reason). None means "blank, skip this page".
    reason is one of: border / border-block / block / column / content /
    full-page / blank. Whether a page is an *instruction page* is not decided here: that
    depends on the other pages in the job, so build() does it from the solid
    ink fraction this leaves in info["solid"] when given a dict.
    """
    fitz = _fitz()
    r = page.rect
    page_area = r.width * r.height or 1.0

    content, frac, (grid, solid, gw, gh, comps) = find_content_box(page, cfg, fitz)
    text_dir = _text_direction(page, fitz)
    if info is not None:
        info["solid"] = sum(solid) / float(gw * gh)
        info["text_dir"] = text_dir
    if content is None or frac < num(cfg, "BLANK_CELL_FRAC"):
        return None, "blank"

    # Line detection wants real pixels, but bounded ones: a 1170x2532
    # screenshot must not cost 30x an A4 page.
    px = num(cfg, "DETECT_PX")
    scale = px / max(r.width, r.height)
    pix = page.get_pixmap(matrix=fitz.Matrix(scale, scale),
                          colorspace=fitz.csGRAY, alpha=False)
    box = find_border_box(pix, cfg)

    if box is not None:
        clip, reason = fitz.Rect(*(v / scale for v in box)) & r, "border"
        # Is the border round a whole sheet rather than just the label? If a
        # cut line inside it separates a solid label from a page of text, keep
        # the label. A bordered label's own internal rules do not qualify:
        # neither side of them is text-only, so the solid-ratio test fails
        # and the whole border is kept.
        inner = find_label_in_border(clip, grid, solid, pix, gw, gh, r, cfg, fitz)
        if inner is not None:
            clip, reason = inner, "border-block"
    else:
        # No drawn border. Is this a multi-part page - instructions, a cut
        # line, then the real label? Horizontal whitespace alone never splits
        # (see find_label_block). Failing that, is the label beside a column
        # of text, across a full-height gutter (see find_label_column)?
        block, reason = find_label_block(grid, solid, gw, gh, cfg), "block"
        if block is None:
            block = find_label_column(comps, solid, gw, gh, cfg,
                                      sideways=text_dir[0] == 0)
            reason = "column"
        if block is None:
            clip, reason = content, "content"
        else:
            clip = _grid_rect(block, r, gw, gh, fitz)
            clip = clip & content if (clip & content).get_area() > 0 else clip

    if clip.get_area() > num(cfg, "SKIP_CROP_AREA") * page_area:
        log("DEBUG", f"{reason} box covers {clip.get_area() / page_area:.0%} "
                     "of the page, not cropping")
        return r, "full-page"

    pad = num(cfg, "CROP_PAD_MM") * MM
    clip = (clip + (-pad, -pad, pad, pad)) & r
    log("DEBUG", f"{reason} box {tuple(round(v, 1) for v in clip)} "
                 f"({clip.get_area() / page_area:.0%} of page)")
    return clip, reason


# -------------------------------------------------------------- placement ----


def place(clip_w, clip_h, cfg):
    """Best fit of a clip into the printable area.

    Tries both orientations and keeps whichever gives the larger scale, so a
    landscape label lands rotated on a portrait roll. Returns (rect_tuple,
    rotate_degrees, scale) with rect in label page coordinates.
    """
    page_w = num(cfg, "LABEL_W_MM") * MM
    page_h = num(cfg, "LABEL_H_MM") * MM
    pad = num(cfg, "PAD_MM") * MM
    ax0 = num(cfg, "MARGIN_L_MM") * MM + pad
    ay0 = num(cfg, "MARGIN_T_MM") * MM + pad
    ax1 = page_w - num(cfg, "MARGIN_R_MM") * MM - pad
    ay1 = page_h - num(cfg, "MARGIN_B_MM") * MM - pad
    aw, ah = ax1 - ax0, ay1 - ay0

    def fit(cw, ch):
        if cw <= 0 or ch <= 0:
            return 0.0
        s = min(aw / cw, ah / ch)
        if not num(cfg, "UPSCALE"):
            s = min(s, 1.0)
        cap = num(cfg, "UPSCALE_MAX")
        return min(s, cap) if cap > 0 else s

    s, rotate = fit(clip_w, clip_h), 0
    s90 = fit(clip_h, clip_w)
    # Rotating has to earn it. A near-square label would otherwise flip on a
    # fraction of a percent, which looks like a bug on the roll.
    if s90 > s * (1.0 + num(cfg, "ROTATE_GAIN")):
        s, rotate = s90, 90

    cw, ch = (clip_w, clip_h) if rotate == 0 else (clip_h, clip_w)
    w, h = cw * s, ch * s
    x0 = ax0 + (aw - w) / 2.0
    y0 = ay0 + (ah - h) / 2.0
    return (x0, y0, x0 + w, y0 + h), rotate, s


# ------------------------------------------------------------------ build ----


def open_input(path, cfg):
    """Open path as a PDF, wrapping a bare image in a page if that is what it is.

    CUPS normally converts images to PDF before the backend sees them, so this
    is belt and braces for direct lp calls and for the test harness.
    """
    fitz = _fitz()
    try:
        doc = fitz.open(path)
        if doc.is_pdf:
            return doc
        # An image document: rasterise onto a page at its native pixel size.
        page = doc[0]
        pix = page.get_pixmap(alpha=False)
        doc.close()
        out = fitz.open()
        p = out.new_page(width=pix.width, height=pix.height)
        p.insert_image(p.rect, pixmap=pix)
        log("DEBUG", f"wrapped {pix.width}x{pix.height} image as a PDF page")
        return out
    except Exception:
        raise


def build(src_path, out_path, cfg, previews=None):
    """Turn an input document into one label page per page worth printing.

    Blank pages are skipped. So are instruction pages (no solid ink at all),
    but only when some other page in the job does carry solid ink: a job that
    is nothing but text still prints. That decision needs the whole job, so
    detection runs over the pages first and placement second.

    previews, if given a list, collects per-page dicts for the test harness.
    Returns the number of label pages written.
    """
    fitz = _fitz()
    src = open_input(src_path, cfg)
    out = fitz.open()
    page_w = num(cfg, "LABEL_W_MM") * MM
    page_h = num(cfg, "LABEL_H_MM") * MM
    max_pages = int(num(cfg, "MAX_PAGES"))
    solid_min = num(cfg, "PAGE_SOLID_MIN")

    # Pass 1: detect. Stops once MAX_PAGES pages with solid ink are in hand,
    # since nothing after them can print: a further label is over the cap and
    # a further instruction page would be skipped.
    detected = []  # (pno, clip, reason, solid_frac or None, text_dir)
    for pno in range(src.page_count):
        page = src[pno]
        info = {}
        try:
            clip, reason = detect_page(page, cfg, info)
        except Exception as e:
            log("WARNING", f"page {pno + 1} detection failed ({e}), fitting whole page")
            clip, reason = page.rect, "full-page"
        detected.append((pno, clip, reason, info.get("solid"),
                         info.get("text_dir", (1, 0))))
        with_label = sum(1 for _, c, _, s, _ in detected
                         if c is not None and (s is None or s >= solid_min))
        if with_label >= max_pages:
            break

    has_label = any(c is not None and s is not None and s >= solid_min
                    for _, c, _, s, _ in detected)

    # Pass 2: place.
    used = 0
    for pno, clip, reason, solid_frac, text_dir in detected:
        page = src[pno]
        if clip is None:
            log("INFO", f"page {pno + 1} is blank, skipped")
            if previews is not None:
                previews.append({"page": pno, "reason": "blank", "clip": None})
            continue
        if has_label and solid_frac is not None and solid_frac < solid_min:
            log("INFO", f"page {pno + 1} is an instruction page "
                        f"({solid_frac:.2%} solid), skipped")
            if previews is not None:
                previews.append({"page": pno, "reason": "instructions", "clip": None})
            continue
        if used >= max_pages:
            log("WARNING", f"stopping at MAX_PAGES={max_pages}, "
                           f"{src.page_count - pno} page(s) not printed")
            break

        # show_pdf_page wants the clip in unrotated coordinates.
        src_clip = clip * page.derotation_matrix
        rect, rotate, scale = place(src_clip.width, src_clip.height, cfg)
        # place() only knows the clip's shape. If the roll wants a quarter
        # turn and the content is already sideways (a sheet an iPhone turned
        # onto portrait A4), turn it the way that makes the text read
        # upright rather than upside down. Text running bottom to top was
        # turned anticlockwise, so it goes back clockwise.
        if rotate == 90 and text_dir[0] == 0:
            rotate = 270 if text_dir[1] < 0 else 90
        p = out.new_page(width=page_w, height=page_h)
        p.show_pdf_page(fitz.Rect(*rect), src, pno, clip=src_clip, rotate=rotate)
        used += 1
        log("INFO", f"page {pno + 1}: {reason}, rotate {rotate}, scale {scale:.2f}")
        if previews is not None:
            previews.append({
                "page": pno, "reason": reason, "clip": tuple(clip),
                "rect": rect, "rotate": rotate, "scale": scale,
            })

    if not used:
        # Every page read as blank. Rather than drop the job, print page 1 as-is.
        log("WARNING", "no printable pages detected, fitting page 1 unchanged")
        page = src[0]
        rect, rotate, _ = place(page.rect.width, page.rect.height, cfg)
        p = out.new_page(width=page_w, height=page_h)
        p.show_pdf_page(fitz.Rect(*rect), src, 0, rotate=rotate)
        used = 1

    out.save(out_path, garbage=3, deflate=True)
    out.close()
    src.close()
    return used


def build_passthrough(src_path, out_path, cfg):
    """Fail-safe path: every page fitted to the label, no detection at all."""
    fitz = _fitz()
    src = open_input(src_path, cfg)
    out = fitz.open()
    page_w = num(cfg, "LABEL_W_MM") * MM
    page_h = num(cfg, "LABEL_H_MM") * MM
    for pno in range(min(src.page_count, int(num(cfg, "MAX_PAGES")))):
        page = src[pno]
        rect, rotate, _ = place(page.rect.width, page.rect.height, cfg)
        p = out.new_page(width=page_w, height=page_h)
        p.show_pdf_page(fitz.Rect(*rect), src, pno, rotate=rotate)
    out.save(out_path, garbage=3, deflate=True)
    out.close()
    src.close()


# ------------------------------------------------------------------ debug ----


def keep_copy(cfg, job, in_path, out_path):
    """Save an in/out pair under KEEP_DIR and prune to KEEP_JOBS newest."""
    import glob
    import shutil
    import time

    d = cfg["KEEP_DIR"]
    keep = int(num(cfg, "KEEP_JOBS"))
    if not d or keep <= 0:
        return
    try:
        os.makedirs(d, exist_ok=True)
        stamp = f"{time.strftime('%Y%m%d-%H%M%S')}-{job}"
        shutil.copy(in_path, os.path.join(d, f"{stamp}-in.pdf"))
        if out_path != in_path:
            shutil.copy(out_path, os.path.join(d, f"{stamp}-out.pdf"))
        stamps = sorted({os.path.basename(p).rsplit("-", 1)[0]
                         for p in glob.glob(os.path.join(d, "*-in.pdf"))})
        for old in stamps[:-keep]:
            for p in glob.glob(os.path.join(d, old + "-*.pdf")):
                os.unlink(p)
    except OSError as e:
        log("WARNING", f"could not keep debug copy ({e})")


# ------------------------------------------------------- CUPS entry point ----


def main(argv):
    import shutil
    import subprocess
    import tempfile

    cfg = load_config()
    _, job, user, title, copies, opts, *rest = argv

    uri = os.environ.get("DEVICE_URI", "")
    target = uri.split(":", 1)[-1].strip("/") if ":" in uri else ""
    target = target or cfg["TARGET_QUEUE"]
    if not target:
        log("ERROR", "no target queue (expected DEVICE_URI labelcrop:/<queue>)")
        return 1

    work = tempfile.mkdtemp(prefix="labelcrop-")
    try:
        inp = os.path.join(work, "in.pdf")
        if rest:
            shutil.copy(rest[0], inp)
        else:
            with open(inp, "wb") as fh:
                shutil.copyfileobj(sys.stdin.buffer, fh)

        outp = os.path.join(work, "out.pdf")
        try:
            n = build(inp, outp, cfg)
            log("INFO", f"{n} label page(s)")
        except Exception as e:
            log("ERROR", f"crop failed ({e!r}), falling back to fit-only")
            try:
                build_passthrough(inp, outp, cfg)
            except Exception as e2:
                log("ERROR", f"fit-only failed too ({e2!r}), sending original")
                outp = inp

        keep_copy(cfg, job, inp, outp)

        # With stdin input CUPS has already expanded copies for us.
        cmd = ["lp", "-d", target, "-n", copies if rest else "1",
               "-t", f"{title} [label]"]
        if cfg["MEDIA"]:
            cmd += ["-o", f"media={cfg['MEDIA']}"]
        if cfg["FINISHINGS"]:
            cmd += ["-o", f"finishings={cfg['FINISHINGS']}"]
        cmd += ["-o", "fit-to-page", "-o", "print-quality=5", outp]

        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode:
            log("ERROR", f"lp failed: {r.stderr.strip() or r.stdout.strip()}")
            return 1
        log("INFO", r.stdout.strip() or f"queued to {target}")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    # CUPS device-discovery call: no arguments.
    if len(sys.argv) == 1:
        print('direct labelcrop "Unknown" "Label crop proxy"')
        sys.exit(0)
    if len(sys.argv) not in (6, 7):
        print("Usage: labelcrop job-id user title copies options [file]",
              file=sys.stderr)
        sys.exit(1)
    sys.exit(main(sys.argv))
