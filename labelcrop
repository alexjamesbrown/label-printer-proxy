    # whole border prints, which is the safe failure.
    "BORDER_CUT_MIN_INK": "0.5",
    # If the detected region covers more than this fraction of the page, the
    # page *is* the content: skip cropping and just fit the page.
    "SKIP_CROP_AREA": "0.85",
    # A page with less than this fraction of inked grid cells is blank.
    "BLANK_CELL_FRAC": "0.0008",
    # A page with less than this fraction of SOLID grid cells carries no label:
    # it is an instruction page ("print this, cut out the label below, drop it
