    # 2.4%, but that shared a page with its label and never reaches this test.
    "PAGE_SOLID_MIN": "0.005",
    # Rotating must beat not rotating by at least this much to be worth it,
    # otherwise a near-square label flips for a fraction of a percent.
    "ROTATE_GAIN": "0.04",
    # 1 = scale small content up to fill the label. 0 = only ever scale down.
    "UPSCALE": "1",
    # Cap on upscaling, as a multiple of natural size. 0 = uncapped.
    "UPSCALE_MAX": "0",
